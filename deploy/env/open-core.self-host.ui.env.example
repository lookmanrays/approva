# Copy to deploy/env/open-core.self-host.ui.env
DATABASE_URL=postgresql://postgres:replace-me@postgres:5432/approva?schema=public
NEXT_PUBLIC_API_BASE_URL=https://api.selfhost.example
APPROVA_INTERNAL_API_BASE_URL=http://approva-api:4000
NEXT_PUBLIC_SAMPLE_APPROVER_EMAIL=approver@example.com
APPROVA_RUNTIME_MODE=open-core
APPROVA_SELF_HOST_MODE=true
APPROVA_DEFAULT_ORGANIZATION_NAME="Default Organization"
APPROVA_DEFAULT_ORGANIZATION_SLUG=default
