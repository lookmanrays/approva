# Copy to deploy/env/open-core.self-host.api.env
PORT=4000
APPROVAL_UI_BASE_URL=https://app.selfhost.example
CAPABILITY_TTL_MINUTES=15
APPROVAL_ACCESS_TOKEN_SECRET=replace-with-strong-secret
WEBHOOK_SIGNING_SECRET=replace-with-strong-secret
APPROVA_RATE_LIMIT_ENABLED=true
APPROVA_RATE_LIMIT_GLOBAL=60
APPROVA_RATE_LIMIT_AUTHENTICATED=300
PASSKEY_RP_NAME=Approva
PASSKEY_RP_ID=app.selfhost.example
PASSKEY_EXPECTED_ORIGINS=https://app.selfhost.example
APPROVER_SESSION_TTL_MINUTES=480
PASSKEY_CHALLENGE_TTL_MINUTES=5
